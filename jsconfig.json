{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "preserve"
  },
  "include": [
    "**/*.js",
    "**/*.html",
    "**/*.css",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    ".git",
    ".cache"
  ]
}
